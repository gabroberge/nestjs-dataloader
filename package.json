{
  "name": "@gabroberge/nestjs-dataloader",
  "version": "3.0.0",
  "description": "A NestJS decorator for dataloader",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.spec.ts\"",
    "lint": "tsc",
    "ci": "bun run lint && bun run test && bun run build",
    "release": "bun run ci && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "bun run format"
    ]
  },
  "keywords": [
    "nestjs",
    "dataloader",
    "graphql",
    "typescript"
  ],
  "author": "Gabriel Roberge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabroberge/nestjs-dataloader.git"
  },
  "homepage": "https://github.com/gabroberge/nestjs-dataloader#readme",
  "bugs": "https://github.com/gabroberge/nestjs-dataloader/issues",
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.4.0",
    "dataloader": "^2.2.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/testing": "^11.1.27",
    "@types/node": "^26.1.0",
    "dataloader": "^2.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
